# Multi-Agent AI System Environment Configuration
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (Free Tier: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Target project directory on host machine to mount into the agent container
# By default, points to a local ./sandbox folder
TARGET_PROJECT_PATH=./sandbox

# Container internal path for the target workspace
TARGET_WORKSPACE=/workspace
